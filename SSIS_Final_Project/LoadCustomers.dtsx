              SQLTask:SqlStatementSource="INSERT INTO ETLErrorLog&#xA;(&#xA;    PackageName,&#xA;    TaskName,&#xA;    ErrorCode,&#xA;    ErrorDescription,&#xA;    ErrorTime&#xA;)&#xA;VALUES&#xA;(&#xA;    'LoadCustomers.dtsx',&#xA;    ?,&#xA;    ?,&#xA;    ?,&#xA;    SYSDATETIME()&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
