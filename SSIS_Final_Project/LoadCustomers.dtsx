                  errorOrTruncationOperation="Computation"
                  errorRowDisposition="FailComponent"
                  exclusionGroup="1"
                  name="Invalid_Basic"
                  synchronousInputId="Package\DFT_LoadCustomers\Conditional Split_CustomerValidation.Inputs[Conditional Split Input]"
                  truncationRowDisposition="FailComponent">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">[ISNULL](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[CustomerID_Converted]}) || [TRIM](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[CustomerID_Converted]}) == "" || [ISNULL](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[CustomerName_Converted]}) || [TRIM](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[CustomerName_Converted]}) == "" || [ISNULL](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[Email_Converted]}) || [TRIM](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[Email_Converted]}) == "" || [FINDSTRING](#{Package\DFT_LoadCustomers\DataConversion_Customers.Outputs[Data Conversion Output].Columns[Email_Converted]},"@",1) == 0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">ISNULL(CustomerID_Converted) || TRIM(CustomerID_Converted) == "" || ISNULL(CustomerName_Converted) || TRIM(CustomerName_Converted) == "" || ISNULL(Email_Converted) || TRIM(Email_Converted) == "" || FINDSTRING(Email_Converted,"@",1) == 0</property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the position of the condition in the list of conditions that the transformation evaluates. The evaluation order is from the lowest to the highest value."
                      name="EvaluationOrder">0</property>
