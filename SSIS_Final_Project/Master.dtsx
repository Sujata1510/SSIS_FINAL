      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{767C6A92-33E7-4E2B-8C87-E73F6ADCC049}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.FileImports (FileName, FileImportStatus, CreatedDate) VALUES (?, 'Received', SYSDATETIME()); SELECT CAST(SCOPE_IDENTITY() AS INT) AS FileImportID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="FileImportID"
            SQLTask:DtsVariableName="User::FileImportID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CurrentFileName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
