          SQLTask:SqlStatementSource="UPDATE dbo.FileImports SET FileImportStatus = 'Successfully Loaded', UpdatedDate = SYSDATETIME() WHERE FileImportID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
