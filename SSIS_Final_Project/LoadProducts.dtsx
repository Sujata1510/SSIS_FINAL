                      name="Expression">![ISNULL](#{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[ProductID_Converted]}) &amp;&amp; [TRIM](#{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[ProductID_Converted]}) != "" &amp;&amp; ![ISNULL](#{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[ProductName_Converted]}) &amp;&amp; [TRIM](#{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[ProductName_Converted]}) != "" &amp;&amp; ![ISNULL](#{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[Price_Converted]}) &amp;&amp; #{Package\DFT_LoadProducts\Data Conversion_Products.Outputs[Data Conversion Output].Columns[Price_Converted]} &gt;= 0</property>
