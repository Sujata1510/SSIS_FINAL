                      expressionType="Notify"
                      name="FriendlyExpression">!ISNULL(ProductID_Converted) &amp;&amp; TRIM(ProductID_Converted) != "" &amp;&amp; !ISNULL(ProductName_Converted) &amp;&amp; TRIM(ProductName_Converted) != "" &amp;&amp; !ISNULL(Price_Converted) &amp;&amp; Price_Converted &gt;= 0</property>
